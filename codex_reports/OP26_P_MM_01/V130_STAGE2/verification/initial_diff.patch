+
+class VersionGateRegressionTests(unittest.TestCase):
+    """Synthetic editions prove infrastructure, never normative readiness."""
+
+    def setUp(self):
+        self.temporary = TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
